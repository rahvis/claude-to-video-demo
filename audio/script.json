    {
      "id": "s05_conformal",
      "lead": 0.4,
      "tail": 0.9,
      "phrases": [
        {
          "text": "Every answer carries a calibrated prediction set.",
          "pause": 0.4
        },
        {
          "text": "One mode, it answers.",

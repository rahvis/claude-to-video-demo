      "phrases": [
        {
          "text": "When the text sounds sure,",
          "pause": 0.12
        },
        {
          "text": "but the calibration says escalate,",
          "pause": 0.12
        },
        {
          "text": "it escalates."
        }
      ]
    },
    {
      "id": "s07_commit",
      "lead": 0.4,
      "tail": 1.1,
      "phrases": [
        {
          "text": "Attestation proves what ran.",
          "pause": 0.15
        },
        {
          "text": "Not what it was calibrated on.",
          "pause": 0.4
        },
        {
          "text": "So CCI commits the calibration set into the root of trust.",
          "pause": 0.4
        },
        {
          "text": "Swap one score, and the fingerprint breaks."
